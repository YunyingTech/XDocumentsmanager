{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "XDocuments",
  "version": "0.1.11",
  "identifier": "com.xdocuments.manager",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNDRDRDE5Rjk1MDhDQTMKUldTampGRDVHYzFFenBPa21uV0M4U2FRSUYvSW01c3NmTmo0SjRwcTFiRWhrYjdUaHBqWmh3NzAK",
      "endpoints": ["https://github.com/YunyingTech/XDocumentsmanager/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" },
      "requireSignedVersion": false
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "XDocuments Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/elasticsearch/**/*",
      "resources/paddle-runtime/**/*",
      "resources/rapidocr-runtime/**/*",
      "scripts/paddle_ocr_worker.py",
      "scripts/paddleocr-requirements.txt",
      "scripts/paddleocr-gpu-requirements.txt",
      "scripts/paddleocr-constraints.txt",
      "scripts/rapid_ocr_worker.py",
      "scripts/rapidocr-directml-requirements.txt",
      "scripts/rapidocr-coreml-requirements.txt",
      "scripts/rapidocr-constraints.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
