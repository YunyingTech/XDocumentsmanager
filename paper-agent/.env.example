# OpenAI-compatible chat endpoint (LM Studio, vLLM, Ollama proxy, or cloud API)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90

# local: sentence-transformers; api: OpenAI-compatible embedding endpoint
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_BASE_URL=
EMBED_API_KEY=

# Runtime data stays local and is ignored by Git.
CHROMA_DIR=./chroma_db
CHECKPOINT_DB=./runtime/checkpoints.sqlite3
MEMORY_FILE=./runtime/memories.json
UPLOAD_DIR=./runtime/uploads

MAX_UPLOAD_MB=50
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=1.25
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
