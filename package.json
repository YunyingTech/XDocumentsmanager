{
  "name": "xdocumentsmanager",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare:elasticsearch": "node src-tauri/scripts/fetch-elasticsearch.mjs",
    "prepare:paddle-runtime": "node src-tauri/scripts/prepare-paddle-runtime.mjs",
    "prepare:rapidocr-runtime": "node src-tauri/scripts/prepare-rapidocr-runtime.mjs",
    "prepare:runtime": "npm run prepare:elasticsearch && npm run prepare:paddle-runtime && npm run prepare:rapidocr-runtime",
    "build:tauri": "npm run prepare:runtime && npm run build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:coverage && npm run build && npm run lint && cargo test --manifest-path src-tauri/Cargo.toml && python -m py_compile src-tauri/scripts/paddle_ocr_worker.py src-tauri/scripts/rapid_ocr_worker.py && python -m unittest discover -s src-tauri/scripts -p \"test_*.py\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
